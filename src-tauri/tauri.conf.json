{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShotDesk",
  "version": "0.1.0",
  "identifier": "com.shotdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShotDesk",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#171a1f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Find screenshots by what they contain"
  }
}
